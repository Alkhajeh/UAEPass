# Public UAE PASS sandbox credentials for the staging demos.
UAEPASS_CLIENT_ID=sandbox_stage
UAEPASS_CLIENT_SECRET=sandbox_stage
# Redirect URI for the client that calls the code-exchange endpoint.
UAEPASS_REDIRECT_URI=https://localhost:8000

# Used for signing, LTV, and signature verification in the signing demo.
UAEPASS_SIGNING_CLIENT_ID=sandbox_stage
UAEPASS_SIGNING_CLIENT_SECRET=sandbox_stage
