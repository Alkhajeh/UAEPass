{
  "name": "@alkhajeh/uaepass-server",
  "version": "0.2.0",
  "description": "Server-side UAE PASS authentication and PDF signing clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alkhajeh/UAEPass.git",
    "directory": "packages/node"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "example": "npm run build && node --env-file=example/.env example/main.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
